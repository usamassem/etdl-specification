{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usamassem/etdl-specification/blob/main/supplements/tree-event/ETDL-Tree-Event-Schema.json",
  "title": "ETDL Tree Event Supplement 1.0",
  "description": "Data model for the ETDL Tree Event Supplement 1.0 (etdl.tree-event@1.0). Defines a domain-neutral tree-of-events structure only; it defines no probability, reliability, or other domain semantics.",
  "type": "object",
  "properties": {
    "tree-event": {
      "type": "object",
      "properties": {
        "trees": {
          "type": "array",
          "items": { "$ref": "#/$defs/tree" }
        }
      },
      "required": ["trees"],
      "additionalProperties": false
    }
  },
  "$defs": {
    "tree": {
      "type": "object",
      "properties": {
        "schema": { "const": "etdl.tree-event/1.0" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/node" },
          "minProperties": 1
        },
        "description": { "type": "string" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["schema", "id", "version", "root", "nodes"],
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/leafNode" },
        { "$ref": "#/$defs/gateNode" }
      ]
    },
    "leafNode": {
      "type": "object",
      "properties": {
        "kind": { "const": "leaf" },
        "eventRef": { "type": "string" },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/nodeStatus" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "gateNode": {
      "type": "object",
      "properties": {
        "kind": { "const": "gate" },
        "gate": { "$ref": "#/$defs/gateKind" },
        "k": {
          "type": "integer",
          "minimum": 1,
          "description": "Required and only meaningful when gate is K_OF_N (Section 4.3)."
        },
        "children": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/nodeStatus" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["kind", "gate", "children"],
      "additionalProperties": false
    },
    "gateKind": {
      "enum": ["AND", "OR", "NOT", "XOR", "K_OF_N"]
    },
    "nodeStatus": {
      "enum": ["discovered", "candidate", "accepted", "rejected"]
    }
  }
}
